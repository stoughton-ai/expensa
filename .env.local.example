# ============================================
# EXPENSA — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Google Gemini AI (https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Supabase — Create a FREE project at https://supabase.com/
# Found in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat_id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Ingest Security (Google Apps Script)
# Generate any long random string — must match what you paste into the Apps Script
# Example: openssl rand -hex 32
EXPENSA_EMAIL_SECRET=your_secret_token_here
